#!/bin/sh
# Written by deploy/install-pi.sh. Saves the sound card levels (what alsamixer
# and Settings, Sound set) to the file Debian restores them from at boot.
# Run by kidnyce-karaoke-alsa-watch after a change, and when it stops.
# Writes only when something changed, to spare the SD card.
set -eu
state=${ALSA_STATE:-/var/lib/alsa/asound.state}
tmp=${ALSA_TMP:-/run/kidnyce-karaoke-asound.state}
alsactl store -f "$tmp" 2>/dev/null || exit 0
if ! cmp -s "$tmp" "$state" 2>/dev/null; then
    install -D -m 644 "$tmp" "$state"
fi
rm -f "$tmp"
