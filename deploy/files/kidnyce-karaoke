#!/usr/bin/env bash
# kidnyce-karaoke: day to day controls for the karaoke Pi.
#
#   kidnyce-karaoke status          services, certificate, address, join code
#   kidnyce-karaoke code            current join code and the QR address
#   kidnyce-karaoke new-code        issue a new join code (everyone scans again)
#   kidnyce-karaoke password        show the admin password (root only)
#   kidnyce-karaoke set-password    choose a new admin password
#   kidnyce-karaoke doctor          check everything and say what is wrong
#   kidnyce-karaoke screens         the board, its ports, the TVs and what each shows
#   kidnyce-karaoke screens auto|single|dual   one screen for everything, or two
#   kidnyce-karaoke screens port NAME|auto     port for one screen, such as HDMI-2
#   kidnyce-karaoke screens swap on|off        swap the singer and room screens
#   kidnyce-karaoke code-on-boot on|off        new join code every time the Pi starts
#   kidnyce-karaoke audio [OUT|reset]          show or set where the sound goes
#   kidnyce-karaoke audio volume 0-100|keep    device volume, kept after a reboot
#   kidnyce-karaoke wifi            join a venue's WiFi from the console
#   kidnyce-karaoke mode [desktop|karaoke]     keep the desktop, or boot to the screens (reboots)
#   kidnyce-karaoke desktop-autostart on|off   desktop mode: open the screens at login
#   kidnyce-karaoke net-fallback on|off        desktop when there is no network at boot
#   kidnyce-karaoke tunnel [status|restart|http2|auto]   internet access for guests
#   kidnyce-karaoke join-from internet|venue   which address the QR code carries
#   kidnyce-karaoke logs [app|nginx|screens|ddns]
#   kidnyce-karaoke restart [app|screens|all]
#   kidnyce-karaoke update-ytdlp    pull the newest yt-dlp now
#   kidnyce-karaoke ddns            update the DNS record now
set -euo pipefail

ETC_DIR=/etc/kidnyce-karaoke
# shellcheck source=/dev/null
source "$ETC_DIR/install.env"
DOMAIN=${DOMAIN:?} PORT=${PORT:?} PREFIX=${PREFIX:?} CERT=${CERT:?}
KIOSK=${KIOSK:-0} KIOSK_USER=${KIOSK_USER:-kiosk}

APP="http://127.0.0.1:$PORT"
ok() { printf '  \033[32mOK\033[0m    %s\n' "$*"; }
warn() { printf '  \033[33mWARN\033[0m  %s\n' "$*"; }
bad() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; }
need_root() { [[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo kidnyce-karaoke $*" >&2; exit 1; }; }

# Admin session against the local app, for actions only the host may take.
# The password comes from the root only file and goes to curl on stdin.
admin_curl() {
    local jar
    jar=$(mktemp)
    trap 'rm -f "$jar"' RETURN
    jq -n --rawfile p "$ETC_DIR/admin-password" '{admin_password: ($p | rtrimstr("\n"))}' |
        curl -fsS -c "$jar" -H "Content-Type: application/json" --data-binary @- "$APP/api/auth" >/dev/null
    curl -fsS -b "$jar" "$@"
}

join_info() {
    curl -fsS --max-time 5 "$APP/api/display/state" | jq -r '.join | "\(.code)\t\(.join_url)"'
}

cmd_code() {
    local code url
    IFS=$'\t' read -r code url < <(join_info)
    echo "Join code: $code"
    echo "QR opens:  $url"
}

cmd_new_code() {
    need_root new-code
    admin_curl -X POST "$APP/api/join_code/rotate" | jq -r '"New join code: \(.code)\nQR opens:      \(.join_url)"'
}

cmd_password() {
    need_root password
    cat "$ETC_DIR/admin-password"
}

cmd_set_password() {
    need_root set-password
    local pw pw2
    read -r -s -p "New admin password (12+ characters): " pw
    echo
    read -r -s -p "Again: " pw2
    echo
    [[ $pw == "$pw2" ]] || { echo "Passwords differ." >&2; exit 1; }
    ((${#pw} >= 12)) || { echo "Use at least 12 characters." >&2; exit 1; }
    install -m 600 -o root -g root /dev/null "$ETC_DIR/admin-password"
    printf '%s\n' "$pw" >"$ETC_DIR/admin-password"
    "$PREFIX/bin/kidnyce-set-admin-password" <"$ETC_DIR/admin-password"
    systemctl restart kidnyce-karaoke
    echo "Admin password changed. Every device has to log in again."
}

set_pref() {
    admin_curl -X POST --data-urlencode "pref=$1" --data-urlencode "val=$2" "$APP/api/change_preferences" |
        jq -e '.[0] == true' >/dev/null || { echo "Could not change $1." >&2; exit 1; }
}

cmd_screens() {
    need_root screens
    case "${1:-show}" in
        show) ;;
        auto | single | dual) set_pref screen_mode "$1" ;;
        port)
            [[ ${2:-} =~ ^[A-Za-z][A-Za-z0-9_.-]{0,31}$ ]] || { echo "Usage: kidnyce-karaoke screens port HDMI-1|HDMI-2|auto" >&2; exit 1; }
            set_pref single_screen_output "$2"
            ;;
        swap)
            case "${2:-}" in
                on) set_pref swap_screens True ;;
                off) set_pref swap_screens False ;;
                *) echo "Usage: kidnyce-karaoke screens swap on|off" >&2; exit 1 ;;
            esac
            ;;
        *) echo "screens: auto, single, dual, port NAME, or swap on|off" >&2; exit 1 ;;
    esac
    [[ ${1:-show} == show ]] || echo "Saved. The screens switch within 5 seconds."
    admin_curl "$APP/api/display/hardware" | jq -r '
        "Board:  \(.board.model), \(.board.memory_gb) GB RAM, "
            + (if .dual_capable then "two screens supported" else "one display port" end),
        "Setup:  \(.settings.screen_mode)   one screen port: \(.settings.single_screen_output)   swap: \(if .settings.swap_screens then "on" else "off" end)",
        "Ports:",
        (.ports[] | "  \(.label) [\(.output)]: "
            + (if .connected
                then "\(.monitor // "TV")\(if .preferred_mode then " " + .preferred_mode else "" end), showing \(.role // "nothing (off)")"
                else "nothing plugged in" end)),
        "Now:    " + (if .layout.mode == "none" then "no TV plugged in"
            else (.layout.screens | map("\(.role) on \(.output)") | join(", ")) end) + "  (\(.layout.note))",
        (if .screens_running then "The screens checked in \(.seconds_since_report) s ago."
            else "The screens are not running." end)'
}

# Days left on the certificate Nginx is serving. Read from the live connection,
# not the file: /etc/letsencrypt/live is root only, and doctor runs without sudo.
cmd_code_on_boot() {
    need_root code-on-boot
    case "${1:-}" in
        on) set_pref new_join_code_on_start True; echo "A new join code at every start." ;;
        off) set_pref new_join_code_on_start False; echo "The join code now only changes with the session or: sudo kidnyce-karaoke new-code" ;;
        *) echo "Usage: kidnyce-karaoke code-on-boot on|off" >&2; exit 1 ;;
    esac
}

# The player's sound skips PipeWire and the desktop volume control: the screen
# session hands Chromium an ALSA device. AUDIO_OUT in kiosk.env is the install
# default. Sound is an app setting (Settings, Sound): the screens read it and apply it,
# so the output and the volume survive a reboot without alsactl.
cmd_audio() {
    local env=$ETC_DIR/kiosk.env install
    install=$(sed -n 's/^AUDIO_OUT=//p' "$env" 2>/dev/null)
    case "${1:-show}" in
        show)
            if [[ $EUID -eq 0 ]]; then
                admin_curl --max-time 5 "$APP/api/display/hardware" | jq -r --arg install "${install:-headphones}" '
                    "Sound out: \(if .audio.output == "" then "install default (\($install))" else .audio.output end)",
                    "Device volume: \(if .audio.level < 0 then "left as set on the Pi" else "\(.audio.level)%" end)"'
            else
                echo "Install default: ${install:-headphones} (run with sudo to see the app setting)"
            fi
            echo "Sound devices:"
            aplay -l 2>/dev/null | awk '/^card/ {print "  " $0}'
            echo "Outputs: hdmi-singer, hdmi-crowd, headphones, usb, default, or a PCM like plughw:CARD=Device,DEV=0"
            return
            ;;
    esac
    need_root audio
    case "$1" in
        volume)
            case "${2:-}" in
                off | keep) set_pref audio_level -1; echo "Device volume left as set on the Pi." ;;
                *)
                    if ! [[ ${2:-} =~ ^[0-9]{1,3}$ ]] || ((10#$2 > 100)); then
                        echo "Usage: kidnyce-karaoke audio volume 0-100|keep" >&2
                        exit 1
                    fi
                    set_pref audio_level "$((10#$2))"
                    echo "Device volume set to $((10#$2))%. It applies within 5 seconds and stays after a reboot."
                    ;;
            esac
            ;;
        reset)
            set_pref audio_output ""
            echo "Sound back to the install default (${install:-headphones}). The screens restart in a few seconds."
            ;;
        hdmi-singer | hdmi-crowd | headphones | usb | default | *:*)
            # A bare word like "card" would leave the player silent, so only
            # keywords and full PCM names pass.
            [[ $1 =~ ^[A-Za-z0-9:=,_.-]+$ ]] || { echo "Not a valid output: $1" >&2; exit 1; }
            set_pref audio_output "$1"
            echo "Sound set to $1. The screens restart in a few seconds."
            ;;
        *)
            echo "Not a valid output: $1. Use hdmi-singer, hdmi-crowd, headphones, usb, default, reset, or a PCM like plughw:CARD=Device,DEV=0" >&2
            exit 1
            ;;
    esac
}

cmd_wifi() {
    need_root wifi
    command -v nmtui >/dev/null || { echo "NetworkManager is not installed." >&2; exit 1; }
    nmtui connect
    sleep 3
    echo "LAN address: $(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')"
    if [[ -x /usr/local/sbin/kidnyce-karaoke-ddns ]]; then
        /usr/local/sbin/kidnyce-karaoke-ddns && echo "DNS record updated: phones can use https://$DOMAIN"
    fi
}

# Desktop mode turns the Raspberry Pi OS desktop back on and stops the screens
# from taking over tty1; karaoke mode undoes it. The app keeps running in both.
# Record the boot mode, so a rerun of the installer keeps it.
set_boot_mode() {
    local env=$ETC_DIR/kiosk.env
    if grep -q '^BOOT_MODE=' "$env" 2>/dev/null; then
        sed -i "s/^BOOT_MODE=.*/BOOT_MODE=$1/" "$env"
    else
        echo "BOOT_MODE=$1" >>"$env"
    fi
}

cmd_mode() {
    local dropin=/etc/systemd/system/getty@tty1.service.d/kidnyce-autologin.conf
    case "${1:-}" in
        desktop)
            need_root mode
            # The installer disabled the login screen, which removes the
            # display-manager.service alias, so look for the real unit.
            local dm="" unit
            for unit in lightdm gdm3 gdm sddm greetd; do
                if systemctl cat "$unit.service" >/dev/null 2>&1; then dm=$unit; break; fi
            done
            [[ -n $dm ]] || { echo "No desktop is installed (Raspberry Pi OS Lite). For WiFi use: sudo kidnyce-karaoke wifi" >&2; exit 1; }
            rm -f "$dropin" "$dropin.off"
            set_boot_mode desktop
            systemctl daemon-reload
            systemctl enable --force "$dm.service" >/dev/null 2>&1
            systemctl set-default graphical.target >/dev/null
            echo "Desktop mode set. The app still starts at boot. Open the screens with the"
            echo "Karaoke Screens icon, or turn on Settings, Screens, 'open the screens when the desktop starts'."
            echo "Rebooting in 5 seconds. Back to the screens at boot: sudo kidnyce-karaoke mode karaoke"
            ;;
        karaoke)
            need_root mode
            mkdir -p "${dropin%/*}"
            printf '%s\n' "# Written by kidnyce-karaoke mode karaoke: log the kiosk user in on tty1 so the screens start at boot." \
                "[Service]" "ExecStart=" "ExecStart=-/sbin/agetty --autologin $KIOSK_USER --noclear %I \$TERM" >"$dropin"
            rm -f "$dropin.off"
            set_boot_mode karaoke
            systemctl daemon-reload
            systemctl disable display-manager.service >/dev/null 2>&1 || true
            systemctl set-default multi-user.target >/dev/null
            echo "Karaoke mode set. Rebooting in 5 seconds."
            ;;
        *)
            if [[ -f $dropin ]]; then echo "Mode: karaoke (boots to the screens)"; else echo "Mode: desktop (Karaoke Screens icon opens the screens)"; fi
            echo "Usage: sudo kidnyce-karaoke mode desktop|karaoke"
            return
            ;;
    esac
    sleep 5
    systemctl reboot
}

# Preview features. Each changes nothing until turned on.
cmd_net_fallback() {
    need_root net-fallback
    local env=$ETC_DIR/kiosk.env value
    case "${1:-}" in
        on) value=1 ;;
        off) value=0 ;;
        *) echo "Usage: kidnyce-karaoke net-fallback on|off" >&2; exit 1 ;;
    esac
    if grep -q '^NET_FALLBACK=' "$env"; then
        sed -i "s/^NET_FALLBACK=.*/NET_FALLBACK=$value/" "$env"
    else
        echo "NET_FALLBACK=$value" >>"$env"
    fi
    if ((value)); then
        systemctl enable kidnyce-karaoke-netfallback.service >/dev/null 2>&1
        echo "On. At boot with no network address the desktop shows; the screens start once connected."
    else
        systemctl disable kidnyce-karaoke-netfallback.service >/dev/null 2>&1
        echo "Off. The screens start at boot whether or not there is a network."
    fi
}

cmd_tunnel() {
    need_root tunnel
    if [[ ! -f $ETC_DIR/tunnel.env ]]; then
        echo "No tunnel. Set one up with the installer: --tunnel karaoke-test.$(sed -n 's/^ZONE=//p' "$ETC_DIR/ddns.env" 2>/dev/null || echo example.com)"
        return
    fi
    case "${1:-status}" in
        status)
            echo "cloudflared: $(systemctl is-active kidnyce-karaoke-tunnel.service 2>/dev/null)"
            /usr/local/sbin/kidnyce-karaoke-tunnel status || true
            ;;
        restart) systemctl restart kidnyce-karaoke-tunnel.service; echo "cloudflared restarted." ;;
        http2)
            # For venues that block UDP 7844 (QUIC).
            echo "TUNNEL_TRANSPORT_PROTOCOL=http2" >"$ETC_DIR/tunnel-run.env"
            systemctl restart kidnyce-karaoke-tunnel.service
            echo "cloudflared now uses HTTP/2 over TCP 7844."
            ;;
        auto)
            rm -f "$ETC_DIR/tunnel-run.env"
            systemctl restart kidnyce-karaoke-tunnel.service
            echo "cloudflared picks QUIC or HTTP/2 itself again."
            ;;
        *) echo "Usage: kidnyce-karaoke tunnel [status|restart|http2|auto]" >&2; exit 1 ;;
    esac
}

cmd_join_from() {
    need_root join-from
    case "${1:-}" in
        internet)
            [[ -f $ETC_DIR/tunnel.env ]] || { echo "No tunnel set up, so the QR code stays on the venue network." >&2; exit 1; }
            set_pref join_via_internet True
            echo "The QR code now works on cellular too: https://$(sed -n 's/^HOSTNAME_PUBLIC=//p' "$ETC_DIR/tunnel.env")"
            ;;
        venue)
            set_pref join_via_internet False
            echo "The QR code now uses https://$DOMAIN (venue network only)."
            ;;
        *) echo "Usage: kidnyce-karaoke join-from internet|venue" >&2; exit 1 ;;
    esac
}

cmd_desktop_autostart() {
    need_root desktop-autostart
    case "${1:-}" in
        on) set_pref desktop_screens_on_login True; echo "Desktop mode: the screens open when the desktop starts." ;;
        off) set_pref desktop_screens_on_login False; echo "Desktop mode: open the screens with the Karaoke Screens icon." ;;
        *) echo "Usage: kidnyce-karaoke desktop-autostart on|off" >&2; exit 1 ;;
    esac
}

cert_days_left() {
    local end
    end=$(openssl s_client -connect 127.0.0.1:443 -servername "$DOMAIN" </dev/null 2>/dev/null |
        openssl x509 -enddate -noout 2>/dev/null | cut -d= -f2 || true)
    [[ -n $end ]] || return 1
    echo $((($(date -d "$end" +%s) - $(date +%s)) / 86400))
}

cmd_status() {
    local unit days
    echo "Kid Nyce Karaoke  https://$DOMAIN"
    # The release, as numbered on the bundles: main v0.7 is 1.23.0+main.0.7.
    echo "Release: $("$PREFIX/venv/bin/python" -I -c 'import importlib.metadata as m; v = m.version("pikaraoke"); print(v.split("+", 1)[-1].replace(".", " v", 1) if "+" in v else v)' 2>/dev/null || echo unknown)"
    for unit in kidnyce-karaoke nginx kidnyce-karaoke-firewall; do
        if systemctl is-active --quiet "$unit"; then ok "$unit running"; else bad "$unit not running"; fi
    done
    if days=$(cert_days_left); then ok "certificate valid for $days more days"; fi
    echo "  LAN address: $(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')"
    cmd_code 2>/dev/null || warn "app not answering yet"
}

cmd_doctor() {
    local failures=0 lan resolved days model throttled
    echo "Checking Kid Nyce Karaoke"

    model=$({ tr -d '\0' </proc/device-tree/model; } 2>/dev/null || echo unknown)
    echo "  Device: $model, $(awk '/MemTotal/ {printf "%.1f GB RAM", $2 / 1048576}' /proc/meminfo)"

    for unit in kidnyce-karaoke nginx; do
        if systemctl is-active --quiet "$unit"; then ok "$unit running"; else bad "$unit not running"; failures=$((failures + 1)); fi
    done
    if systemctl is-active --quiet kidnyce-karaoke-firewall; then ok "firewall loaded"; else warn "firewall not loaded"; fi

    if curl -fsS --max-time 5 "$APP/api/healthz" >/dev/null; then ok "app answers on loopback"; else bad "app does not answer on $APP"; failures=$((failures + 1)); fi
    if curl -fsS --noproxy '*' --max-time 5 --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/api/healthz" >/dev/null 2>&1; then
        ok "HTTPS through Nginx with a trusted certificate"
    elif curl -fsSk --noproxy '*' --max-time 5 --resolve "$DOMAIN:443:127.0.0.1" "https://$DOMAIN/api/healthz" >/dev/null 2>&1; then
        warn "HTTPS works but the certificate is not trusted (self signed or staging)"
    else
        bad "HTTPS through Nginx failed"; failures=$((failures + 1))
    fi

    if days=$(cert_days_left); then
        if ((days > 14)); then ok "certificate: $days days left"; else warn "certificate: only $days days left, check: sudo certbot renew --dry-run"; fi
    else
        bad "could not read the certificate Nginx serves on 443"; failures=$((failures + 1))
    fi

    lan=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')
    resolved=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR == 1 {print $1}')
    if [[ -n $lan && $resolved == "$lan" ]]; then
        ok "$DOMAIN resolves to this Pi ($lan)"
    else
        warn "$DOMAIN resolves to ${resolved:-nothing}, this Pi is ${lan:-offline}. Phones will not find it by name. Run: sudo kidnyce-karaoke ddns"
    fi

    if [[ -x $PREFIX/bin/deno ]]; then ok "deno $("$PREFIX/bin/deno" --version | awk 'NR == 1 {print $2}') for yt-dlp"; else warn "deno missing, YouTube downloads may fail"; fi
    ok "yt-dlp $("$PREFIX/venv/bin/python" -I -m yt_dlp --version 2>/dev/null || echo unknown)"

    if command -v vcgencmd >/dev/null; then
        throttled=$(vcgencmd get_throttled | cut -d= -f2)
        if [[ $throttled == 0x0 ]]; then ok "power and temperature fine ($(vcgencmd measure_temp | cut -d= -f2))"; else warn "throttled=$throttled: weak power supply or overheating. Use the official 5V 3A supply."; fi
    fi

    # The kernel slows the whole app, the song playing included, each time it
    # reaches its soft memory cap. Downloads are what push it there.
    local events=/sys/fs/cgroup/system.slice/kidnyce-karaoke.service/memory.events high
    if [[ -r $events ]]; then
        high=$(awk '$1 == "high" {print $2}' "$events")
        if [[ ${high:-0} == 0 ]]; then
            ok "app memory never reached its soft cap ($(systemctl show -P MemoryHigh kidnyce-karaoke 2>/dev/null | awk '{printf "%d MB", $1 / 1048576}'))"
        else
            warn "app memory hit its soft cap $high times since it started, which can freeze the song playing. Rerun the installer to size the cap to this board."
        fi
    fi

    if [[ ${KIOSK:-0} == 1 ]]; then
        local role up=() owner=(-u "$KIOSK_USER")
        if [[ ! -f /etc/systemd/system/getty@tty1.service.d/kidnyce-autologin.conf ]]; then
            # Desktop mode: the screens run in the desktop user's session, when opened.
            owner=()
            if pgrep -f 'kiosk-session.sh --(desktop|autostart)' >/dev/null; then
                ok "desktop mode: the screens are open"
            else
                ok "desktop mode: the screens are closed. Open them with the Karaoke Screens icon."
            fi
        elif pgrep -u "$KIOSK_USER" -f 'kiosk-session.sh' >/dev/null; then
            ok "screen session running"
        else
            warn "screen session not running (is a TV plugged in? check: kidnyce-karaoke logs screens)"
        fi
        for role in singer crowd all; do
            [[ -n $(pgrep "${owner[@]}" -f -- "--user-data-dir=.*kidnyce-kiosk/$role( |$)" || true) ]] && up+=("$role")
        done
        case "${up[*]}" in
            "singer crowd") ok "two screens up: singer and room" ;;
            all) ok "one screen up, showing everything (sudo kidnyce-karaoke screens for details)" ;;
            "") ((${#owner[@]})) && warn "no screen browser running (is a TV plugged in? check: kidnyce-karaoke logs screens)" ;;
            *) warn "screens up: ${up[*]} (sudo kidnyce-karaoke screens for details)" ;;
        esac
        if command -v aplay >/dev/null; then echo "  Sound devices:"; aplay -l 2>/dev/null | awk '/^card/ {print "    " $0}'; fi
    fi

    echo
    if ((failures)); then echo "$failures problem(s) found."; exit 1; fi
    echo "All good."
}

cmd_logs() {
    case "${1:-app}" in
        app) journalctl -u kidnyce-karaoke -n 200 --no-pager ;;
        nginx) tail -n 100 /var/log/nginx/error.log ;;
        screens)
            tail -n 200 "/home/$KIOSK_USER/kiosk.log" 2>/dev/null
            # Desktop mode logs to the desktop user's home.
            local f
            for f in /home/*/.cache/kidnyce-karaoke/screens.log; do
                [[ -r $f ]] && { echo "== $f"; tail -n 100 "$f"; }
            done
            ;;
        ddns) journalctl -u kidnyce-karaoke-ddns -n 50 --no-pager ;;
        *) echo "logs: app, nginx, screens or ddns" >&2; exit 1 ;;
    esac
}

cmd_restart() {
    need_root restart
    case "${1:-all}" in
        app) systemctl restart kidnyce-karaoke ;;
        # Karaoke mode: getty starts the screens again. Desktop mode: they close; reopen from the icon.
        screens) pkill -f kiosk-session.sh || true ;;
        all) systemctl restart kidnyce-karaoke nginx; pkill -f kiosk-session.sh || true ;;
        *) echo "restart: app, screens or all" >&2; exit 1 ;;
    esac
}

case "${1:-status}" in
    status) cmd_status ;;
    code) cmd_code ;;
    new-code) cmd_new_code ;;
    password) cmd_password ;;
    set-password) cmd_set_password ;;
    doctor) cmd_doctor ;;
    screens) cmd_screens "${2:-show}" "${3:-}" ;;
    code-on-boot) cmd_code_on_boot "${2:-}" ;;
    desktop-autostart) cmd_desktop_autostart "${2:-}" ;;
    net-fallback) cmd_net_fallback "${2:-}" ;;
    tunnel) cmd_tunnel "${2:-status}" ;;
    join-from) cmd_join_from "${2:-}" ;;
    audio) cmd_audio "${2:-show}" "${3:-}" ;;
    wifi) cmd_wifi ;;
    mode) cmd_mode "${2:-}" ;;
    logs) cmd_logs "${2:-app}" ;;
    restart) cmd_restart "${2:-all}" ;;
    update-ytdlp) need_root update-ytdlp; systemctl start kidnyce-karaoke-ytdlp; "$PREFIX/venv/bin/python" -I -m yt_dlp --version ;;
    ddns) need_root ddns; /usr/local/sbin/kidnyce-karaoke-ddns && echo "DNS record checked." ;;
    -h | --help | help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' ;;
