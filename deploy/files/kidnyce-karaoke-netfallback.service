# Preview: show the desktop when the Pi boots with no network, then the karaoke
# screens once it has one. Written by deploy/install-pi.sh; enabled only by
# --net-fallback on or: sudo kidnyce-karaoke net-fallback on
[Unit]
Description=Kid Nyce Karaoke: desktop when there is no network at boot
After=NetworkManager.service systemd-logind.service getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/kidnyce-karaoke-netfallback
Restart=no

[Install]
WantedBy=multi-user.target
