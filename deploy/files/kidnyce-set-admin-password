#!/usr/bin/env bash
# Reads a new admin password on stdin and stores its salted PBKDF2 hash in the
# app's config, as the app user. Changing it logs every device out.
set -euo pipefail
# shellcheck source=/dev/null
source /etc/kidnyce-karaoke/install.env
APP_USER=${APP_USER:?} DATA_DIR=${DATA_DIR:?} PREFIX=${PREFIX:?}
cd "$DATA_DIR"
exec runuser -u "$APP_USER" -- env HOME="$DATA_DIR" "$PREFIX/venv/bin/python" -I -c '
import sys
from pikaraoke.lib.admin_auth import AdminAuth
from pikaraoke.lib.preference_manager import PreferenceManager
password = sys.stdin.readline().rstrip("\n")
if len(password) < 12:
    sys.exit("admin password must be at least 12 characters")
AdminAuth(PreferenceManager("config.ini")).set_password(password)
'
