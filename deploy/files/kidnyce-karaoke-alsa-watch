#!/bin/bash
# Written by deploy/install-pi.sh. Saves the sound card levels (what Settings,
# Sound or alsamixer set) once, 30 seconds after they change, so pulling the
# plug keeps them. Debian normally saves them only at a clean shutdown.
#
# Event driven: `alsactl monitor` blocks in the kernel until a mixer control
# changes, so nothing runs while the levels stay put. A burst of changes (a
# slider being dragged) ends in one save, 30 seconds after the first change.
# The service saves once more when it stops, so a clean shutdown inside those
# 30 seconds loses nothing either.
set -u
WAIT=${ALSA_SAVE_AFTER_SECONDS:-30}
SAVE=${ALSA_SAVE_CMD:-/usr/local/sbin/kidnyce-karaoke-alsa-save}

# Line buffered, so each event arrives as it happens.
coproc MON { exec stdbuf -oL alsactl monitor 2>/dev/null; }
exec {events}<&"${MON[0]}"

while read -r -u "$events" _; do
    # A change. Absorb whatever follows for WAIT seconds, then save once.
    deadline=$((SECONDS + WAIT))
    while ((SECONDS < deadline)); do
        read -r -t "$((deadline - SECONDS))" -u "$events" _
        rc=$?
        ((rc == 0)) && continue
        # Above 128 is the timeout; anything else means alsactl went away.
        ((rc > 128)) || { "$SAVE"; exit 1; }
    done
    "$SAVE"
done
# alsactl ended (the card went away): systemd starts this again.
exit 1
