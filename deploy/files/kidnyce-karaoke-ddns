#!/usr/bin/env bash
# Points the karaoke hostname at this Pi's current LAN address through the
# Cloudflare API, so phones on the venue Wi-Fi reach it by name with a valid
# certificate. Runs at boot and every few minutes from a systemd timer.
#
# The record is DNS only (not proxied): it holds a private address that only
# means something inside the venue network.
set -euo pipefail

CONFIG=${KIDNYCE_DDNS_CONFIG:-/etc/kidnyce-karaoke/ddns.env}
# shellcheck source=/dev/null
source "$CONFIG"

: "${DOMAIN:?DOMAIN missing in $CONFIG}"
: "${ZONE:?ZONE missing in $CONFIG}"
: "${TOKEN_FILE:?TOKEN_FILE missing in $CONFIG}"
API=${CF_API_BASE:-https://api.cloudflare.com/client/v4}
TTL=${TTL:-60}
STATE_DIR=${STATE_DIR:-/var/lib/kidnyce-karaoke-ddns}

log() { printf '%s\n' "kidnyce-ddns: $*" >&2; }

lan_ip() {
    if [[ -n "${IFACE:-}" ]]; then
        ip -4 -o addr show dev "$IFACE" scope global | awk '{split($4, a, "/"); print a[1]; exit}'
    else
        # The source address the kernel would use to leave this network.
        ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}'
    fi
}

is_private_ipv4() {
    local ip=$1 a b
    [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
    a=${BASH_REMATCH[1]}
    b=${BASH_REMATCH[2]}
    ((a == 10)) && return 0
    ((a == 172 && b >= 16 && b <= 31)) && return 0
    ((a == 192 && b == 168)) && return 0
    ((a == 100 && b >= 64 && b <= 127)) && return 0
    return 1
}

# The token goes to curl on stdin, never on the command line where any local
# user could read it from the process list. The body holds no secret.
cf() {
    local method=$1 url=$2 body=${3:-}
    local token
    local -a extra=()
    token=$(<"$TOKEN_FILE")
    if [[ -n "$body" ]]; then
        extra=(--header "Content-Type: application/json" --data-binary "$body")
    fi
    printf 'header = "Authorization: Bearer %s"\n' "$token" |
        curl --silent --show-error --fail-with-body --max-time 20 \
            --request "$method" --config - "${extra[@]}" "$url"
}

main() {
    local ip zone_id records record_id current body response
    ip=$(lan_ip)
    if [[ -z "$ip" ]]; then
        log "no IPv4 address yet, will try again on the next run"
        exit 0
    fi
    if ! is_private_ipv4 "$ip" && [[ "${ALLOW_PUBLIC_IP:-0}" != 1 ]]; then
        log "refusing to publish non private address $ip (set ALLOW_PUBLIC_IP=1 to override)"
        exit 1
    fi

    mkdir -p "$STATE_DIR"
    if [[ -f "$STATE_DIR/last_ip" && "$(<"$STATE_DIR/last_ip")" == "$ip" &&
        -n "$(find "$STATE_DIR/last_ip" -mmin -60 2>/dev/null)" ]]; then
        exit 0
    fi

    zone_id=${ZONE_ID:-}
    if [[ -z "$zone_id" ]]; then
        zone_id=$(cf GET "$API/zones?name=$ZONE" | jq -r '.result[0].id // empty')
        [[ -n "$zone_id" ]] || { log "zone $ZONE not visible to this token"; exit 1; }
    fi

    records=$(cf GET "$API/zones/$zone_id/dns_records?type=A&name=$DOMAIN")
    record_id=$(jq -r '.result[0].id // empty' <<<"$records")
    current=$(jq -r '.result[0].content // empty' <<<"$records")

    if [[ "$current" == "$ip" ]]; then
        printf '%s' "$ip" >"$STATE_DIR/last_ip"
        exit 0
    fi

    body=$(jq -cn --arg n "$DOMAIN" --arg c "$ip" --argjson t "$TTL" \
        '{type: "A", name: $n, content: $c, ttl: $t, proxied: false, comment: "Kid Nyce Karaoke Pi LAN address"}')
    if [[ -n "$record_id" ]]; then
        response=$(cf PUT "$API/zones/$zone_id/dns_records/$record_id" "$body")
    else
        response=$(cf POST "$API/zones/$zone_id/dns_records" "$body")
    fi
    if [[ "$(jq -r '.success' <<<"$response")" != "true" ]]; then
        log "Cloudflare refused the update: $(jq -c '.errors' <<<"$response")"
        exit 1
    fi
    printf '%s' "$ip" >"$STATE_DIR/last_ip"
    log "$DOMAIN now points to $ip (was ${current:-unset})"
}

main "$@"
